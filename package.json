{
  "name": "nodegx-studio",
  "version": "0.1.0",
  "private": true,
  "description": "A Design / Workflow / Data editor for NodeGX apps, on your own machine. Imports apps built on the Bubble™ platform.",
  "license": "GPL-3.0-only",
  "main": "app/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node app/launch.mjs",
    "serve": "node editor/serve.mjs",
    "vendor": "node scripts/vendor.mjs",
    "mcpb": "node scripts/mcpb.mjs",
    "check:vendor": "node scripts/vendor.mjs --check",
    "check": "node scripts/vendor.mjs --check && node editor/rules-check.mjs && node editor/phrases-check.mjs && node editor/pagedata-check.mjs && node editor/reusable-check.mjs && node editor/check.mjs && node editor/data-check.mjs && node editor/timeline-check.mjs && node editor/hosted-check.mjs && node editor/fngraph-check.mjs && node editor/functions-check.mjs && node import/check.mjs && node import/dictionary-check.mjs && node app/check.mjs && node app/publish-check.mjs && node app/unbuilt-check.mjs && node editor/layouttips-check.mjs",
    "check:editor": "node editor/check.mjs",
    "check:pagedata": "node editor/pagedata-check.mjs",
    "check:timeline": "node editor/timeline-check.mjs",
    "check:data": "node editor/data-check.mjs",
    "check:hosted": "node editor/hosted-check.mjs",
    "check:functions": "node editor/fngraph-check.mjs && node editor/functions-check.mjs",
    "check:reusable": "node editor/reusable-check.mjs",
    "check:rules": "node editor/rules-check.mjs",
    "check:import": "node import/check.mjs",
    "check:app": "node app/check.mjs",
    "check:publish": "node app/publish-check.mjs",
    "check:server": "node app/server-publish-check.mjs",
    "check:unbuilt": "node app/unbuilt-check.mjs",
    "check:layouttips": "node editor/layouttips-check.mjs",
    "smoke": "node app/launch.mjs --smoke",
    "check:dictionary": "node import/dictionary-check.mjs",
    "check:phrases": "node editor/phrases-check.mjs",
    "package": "electron-builder --dir --publish never -c.mac.identity=-",
    "dist": "electron-builder --publish never -c.mac.identity=-",
    "dist:signed": "electron-builder --publish never"
  },
  "dependencies": {
    "@nodegx/backend-map": "0.1.2",
    "@nodegx/mcp": "0.2.6",
    "@nodegx/preview": "0.2.5"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "productName": "NodeGX Studio",
  "build": {
    "appId": "io.nodegx.studio",
    "productName": "NodeGX Studio",
    "copyright": "GPL-3.0-only. The Low-Code Foundation and NodeGX contributors.",
    "directories": {
      "output": "dist"
    },
    "asar": false,
    "npmRebuild": false,
    "files": [
      "app/**",
      "editor/**",
      "lib/**",
      "import/*.mjs",
      "vendor/**",
      "package.json",
      "LICENSE",
      "!**/*check.mjs",
      "!**/.DS_Store"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "app/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Allow the app you are building to use the microphone while Studio shows it?",
        "NSCameraUsageDescription": "Allow the app you are building to use the camera while Studio shows it?"
      }
    },
    "win": {
      "icon": "app/icon.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "app/icon.png",
      "category": "Development",
      "target": [
        "AppImage"
      ],
      "executableName": "nodegx-studio"
    }
  },
  "author": {
    "name": "The Low-Code Foundation",
    "url": "https://nodegx.io"
  }
}

{
  "name": "nodegx-studio",
  "version": "0.1.0",
  "private": true,
  "description": "A Design / Workflow / Data editor for NodeGX apps, on your own machine. Imports apps built on the Bubble™ platform.",
  "license": "GPL-3.0-only",
  "main": "app/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node app/launch.mjs",
    "serve": "node editor/serve.mjs",
    "check": "node editor/check.mjs && node import/check.mjs",
    "check:editor": "node editor/check.mjs",
    "check:import": "node import/check.mjs",
    "smoke": "node app/launch.mjs --smoke"
  },
  "devDependencies": {
    "electron": "43.2.0"
  }
}
